# Copy this file to .env for local Docker use. Do not commit .env.
MORTGAGEFLOW_SQL_PASSWORD=replace-with-a-strong-local-development-password
ConnectionStrings__DefaultConnection=Server=127.0.0.1,14333;Database=MortgageFlow;User Id=sa;Password=replace-with-the-same-local-development-password;TrustServerCertificate=True;Encrypt=True
Jwt__Issuer=MortgageFlow
Jwt__Audience=MortgageFlow.Api
Jwt__SigningKey=replace-with-at-least-32-characters-for-local-development
Jwt__ExpiryMinutes=60
Seed__DemoPassword=replace-with-a-strong-synthetic-demo-password
Database__ApplyMigrationsOnStartup=true
